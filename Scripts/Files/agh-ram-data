#!/bin/sh /etc/rc.common
# BE12 Pro: keep AdGuard Home's work data in tmpfs, not the NAND overlay.
# /etc/AdGuardHome/AdGuardHome.yaml and the core remain persistent.
START=05

start() {
	local data=/etc/AdGuardHome/data
	local ram=/tmp/AdGuardHome/data

	mkdir -p "$ram" || return 1
	[ -d /etc/AdGuardHome ] || return 0

	if [ -L "$data" ]; then
		case "$(readlink "$data")" in
			"$ram") return 0 ;;
			# Migrate the tmpfs path suggested for manual setup before this image.
			/tmp/AdGuardHome-data) rm "$data" || return 1 ;;
			*) echo "agh-ram-data: refusing to replace unexpected symlink $data" >&2
				return 1 ;;
		esac
	fi

	# One-time migration from persistent data. The user opted to discard logs,
	# statistics, sessions and downloaded filters on every reboot.
	if [ -e "$data" ]; then
		if [ ! -d "$data" ]; then
			echo "agh-ram-data: refusing to replace non-directory $data" >&2
			return 1
		fi
		rm -rf "$data" || return 1
	fi
	ln -s "$ram" "$data"
}
